# 全局配置模板。复制一次即可, 所有 worktree 共用:
#
#   cp apps/website/.env.example ~/.vois/.env
#
# dev / preview 服务器和构建都从 ~/.vois/.env 读 (见 vite.config.ts 的 envDir)。
# CI 没有这个目录, 改用 secrets 注入同名的 process.env, 优先级高于文件。

VITE_APP_ID=your_app_id
VITE_APP_KEY=your_app_key

# 高德地图, 仅设备定位页需要
VITE_AMAP_KEY=your_amap_key
VITE_AMAP_SECURITY_CODE=your_amap_security_code

# 可选: 把 /v2 代理到别的后端
# VITE_API_TARGET=https://api.voischat.cn
# 可选: 同上, 只影响 /v2/subuser (群组管理)
# VITE_SUBUSER_API_TARGET=https://api.voischat.cn
