{
  "name": "vois-app-webview-next",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev:app": "vp run website#dev",
    "dev:docs": "vp run docs#dev",
    "build:app": "vp run website#build",
    "preview:app": "vp run website#preview",
    "preview:production": "vp run website#build && cd apps/website && vp preview --base /vois-app-webview-next/ --host --port 8080 --debug",
    "ready": "vp check && vp run -r test && vp run -r build",
    "release": "bumpp --recursive",
    "up": "vpx taze -Ir major"
  },
  "dependencies": {
    "vite-plugin-vois-webview-debug": "^0.1.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "catalog:tooling",
    "@oxlint/plugins": "catalog:tooling",
    "bumpp": "^12.3.0",
    "commitlint": "catalog:tooling",
    "eslint-plugin-slop": "catalog:tooling",
    "taze": "catalog:tooling",
    "vite-plus": "catalog:tooling"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
