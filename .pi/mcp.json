{
  "mcpServers": {
    "vois-debug": {
      "command": "node",
      "args": ["packages/mcp/src/cli.ts"]
    },
    "tempad-dev": {
      "type": "stdio",
      "command": "node",
      "args": ["~/.vois/tools/tempad-mcp/node_modules/@tempad-dev/mcp/dist/cli.mjs"],
      "description": "TemPad Dev 0.11.0 (pin: extension must be 0.23.x): read Figma designs (code/screenshot/structure/design-system) from the connected browser tab, and author native Figma layers"
    },
    "rea": {
      "type": "stdio",
      "command": "~/.vois/tools/rea/node_modules/.bin/rea",
      "args": ["mcp"],
      "description": "Reverse engineering: native/Android/iOS artifacts, JS bundles, browser and runtime observation",
      "env": {
        "HOPPER_LAUNCHER_PATH": "!echo \"${HOPPER_LAUNCHER_PATH:-$HOME/Applications/Hopper Disassembler.app/Contents/MacOS/hopper}\"",
        "REA_JADX_MCP_JAR": "!echo \"${REA_JADX_MCP_JAR:-$HOME/.vois/tools/jadx-headless-mcp-0.7.1-all.jar}\"",
        "JAVA_HOME": "!echo \"${JAVA_HOME:-$(/opt/homebrew/bin/brew --prefix openjdk 2>/dev/null || echo /opt/homebrew/opt/openjdk)}\""
      }
    }
  }
}
